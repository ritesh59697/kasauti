VITE_BASE_RPC_URL=https://mainnet.base.org
VITE_EXPLORER_URL=https://base.blockscout.com
# Deployed Kasauti contract on Base mainnet (leave empty until deployed; the UI then previews only)
VITE_KASAUTI_ADDRESS=
# Optional: enables WalletConnect-based wallets in the connect modal
VITE_WALLETCONNECT_PROJECT_ID=
# Starting values for the trade form (the trader can change them)
VITE_DEFAULT_BAND_BPS=50
VITE_DEFAULT_MAX_AGE_MIN=60
VITE_DEFAULT_CLOSED_BAND_BPS=150
