# Base mainnet RPC (public endpoint works for reads and fork tests; a private one is faster)
BASE_RPC_URL=https://mainnet.base.org
# Coinbase tokenized stocks API
TOKENIZED_STOCKS_API=https://api.coinbase.com/v1/tokenized-stocks
# Chainlink feed directory for Base mainnet
CHAINLINK_DIRECTORY_URL=https://reference-data-directory.vercel.app/feeds-ethereum-mainnet-base-1.json
# DexScreener pair lookup (used only to discover candidate pools; every pool is verified onchain)
DEXSCREENER_TOKEN_URL=https://api.dexscreener.com/latest/dex/tokens
# Quote token symbol to price stocks against (resolved to an address via the pools found)
QUOTE_SYMBOL=USDC
# Coinbase onchain oracle registry (returns multiplier + paused per token).
# Source: https://docs.base.org/sdks/tokenized-stocks/overview ("Onchain Registry")
ORACLE_REGISTRY=0x3f3E8cf41cdd3b1D118c16471aB0113DfDDd5CaD
# Aero's official Base CL deployment file (trusted source for the pool factory allowlist)
AERO_CL_DEPLOYMENT_URL=https://raw.githubusercontent.com/dromos-labs/metadex-slipstream-public/main/deployment-addresses/cl-base.json
# Trade size, in whole USDC, for `npm run evidence` (a local simulation; nothing is sent)
EVIDENCE_AMOUNT_USDC=5
